# WebSecurity SaaS - Environment Configuration

# Google Genkit Configuration
GENKIT_API_KEY=your_genkit_api_key_here
GENKIT_PROJECT_ID=your_gcp_project_id
GENKIT_MODEL=gemini-1.5-pro
GENKIT_REGION=us-central1

# Chrome DevTools MCP Configuration
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
CHROME_HEADLESS=true
CHROME_TIMEOUT=30000
CHROME_VIEWPORT_WIDTH=1920
CHROME_VIEWPORT_HEIGHT=1080

# Security Scan Configuration
SCAN_TIMEOUT=60000
MAX_CONCURRENT_SCANS=5
SCAN_USER_AGENT=WebSecurity-SaaS-Scanner/1.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/websecurity.log

# Development Configuration
NODE_ENV=development
PORT=3000
DEBUG=websecurity:*

# AI Analysis Configuration
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.3

# Report Configuration
REPORT_FORMAT=json
REPORT_INCLUDE_SCREENSHOTS=true
REPORT_MAX_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

